{
  "name": "codeclash",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "test": "npm run test:all",
    "test:all": "npm test -w apps/api && npm test -w apps/judge-worker && npm test -w packages/common",
    "test:api": "npm test -w apps/api",
    "test:worker": "npm test -w apps/judge-worker",
    "test:common": "npm test -w packages/common",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run dev -w apps/judge-worker",
    "build:web": "npm run build -w apps/web",
    "problems:generate": "npm --prefix problem-bank run generate --",
    "problems:validate": "npm --prefix problem-bank run validate --",
    "problems:import": "npm --prefix problem-bank run import --",
    "problems:test:generate": "npm --prefix problem-bank run test:generate --",
    "problems:test:verify": "npm --prefix problem-bank run test:verify --",
    "problems:test:summary": "npm --prefix problem-bank run test:summary --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adicodeswell/CodeClash.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/adicodeswell/CodeClash/issues"
  },
  "homepage": "https://github.com/adicodeswell/CodeClash#readme",
  "private": "true",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prisma": "^7.10.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
