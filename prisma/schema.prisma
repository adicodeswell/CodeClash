generator client {
  provider = "prisma-client"
  output   = "../packages/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
}

enum SubmissionVerdict {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  JUDGE_ERROR
}

model User {
  id              String     @id @default(cuid())
  username        String     @unique @db.VarChar(30)
  emailNormalized String     @unique @db.VarChar(320)
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  submissions     Submission[]

  @@index([createdAt])
  @@map("users")
}

model Problem {
  id             String            @id @default(cuid())
  slug           String            @unique @db.VarChar(160)
  title          String            @db.VarChar(200)
  statement      String
  difficulty     ProblemDifficulty
  topics         String[]          @default([])
  status         ProblemStatus     @default(DRAFT)
  timeLimitMs    Int               @default(2000)
  memoryLimitKb  Int               @default(262144)
  packageVersion String            @default("1")
  contentHash    String?
  // Map language key to language ID, enabled flag, starter template, and structure metadata.
  languages      Json
  // Protected list of { ordinal, visibility, input, expectedOutput } records.
  testCases      Json
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  submissions    Submission[]

  @@index([status, difficulty])
  @@index([status, createdAt])
  @@map("problems")
}

model Submission {
  id                String            @id @default(cuid())
  userId            String
  problemId         String
  language          String            @db.VarChar(30)
  sourceCode        String
  packageVersion    String
  status            SubmissionStatus  @default(QUEUED)
  verdict           SubmissionVerdict?
  judge0Token       String?
  currentTestIndex  Int               @default(0)
  passedTestCount   Int               @default(0)
  totalTestCount    Int               @default(0)
  createdAt         DateTime          @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  runtimeMs         Int?
  memoryKb          Int?
  errorCode         String?
  errorSummary      String?
  retryCount        Int               @default(0)

  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  problem           Problem           @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, problemId, createdAt])
  @@index([status, createdAt])
  @@map("submissions")
}